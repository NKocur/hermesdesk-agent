{
  "name": "hermesdesk-agent",
  "version": "0.1.0-alpha.3",
  "description": "Pi-based terminal coding client for HermesDesk and Strata",
  "type": "module",
  "bin": {
    "hermesdesk": "bin/hermesdesk.js",
    "hermesdesk-agent": "bin/hermesdesk.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node bin/hermesdesk.js",
    "format": "prettier --write bin src tests",
    "format:check": "prettier --check bin src tests"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "npm-shrinkwrap.json",
    "LICENSE"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "license": "MIT",
  "author": "Nash Kocur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NKocur/hermesdesk-agent.git"
  },
  "homepage": "https://github.com/NKocur/hermesdesk-agent#readme",
  "bugs": {
    "url": "https://github.com/NKocur/hermesdesk-agent/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
